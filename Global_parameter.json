{
  "_readme": [
    "EPI_shim 统一配置文件 —— 所有可调参数（数据路径、电流、串口、算法）的唯一来源。",
    "Python 脚本与 notebook 通过 code/config.py 读取本文件，无需关心当前工作目录。",
    "单位约定：用户侧电流一律用 A；下发 DAC 前由 config.py 换算为整数 mA。",
    "BDAC 协议数值字段为 4 位十六进制(%04X)，故单方向绝对值不得超过 current.protocol.max_mA。",
    "修改后运行 `python code/config.py` 可自检并打印当前生效参数。"
  ],

  "project": {
    "name": "dynamic_shim"
  },

  "data": {
    "_comment": "数据根目录与文件名。root_dir 相对项目根目录，也可写绝对路径。",
    "root_dir": "./data",
    "subject": "sub-03",
    "b0map_masked_file": "B0_map_Hz_to_master_masked.nii.gz",
    "shimming_currents_csv": "shimming_currents.csv"
  },

  "serial": {
    "port": "COM11",
    "baudrate": 115200,
    "timeout_s": 0.2
  },

  "current": {
    "unit": "A",

    "limits": {
      "_comment": "优化器 lsq_linear 的上下界，同时作为下发 DAC 前的硬限幅。支持非对称。",
      "positive_A": 2.0,
      "negative_A": 2.0
    },

    "on_overflow": "raise",
    "_on_overflow_comment": "raise = 超限直接报错; clip = 静默截断到上限",

    "protocol": {
      "max_mA": 4095,
      "resolution_mA": 1
    },

    "test": {
      "_comment": "coil_control.py 单通道连通性测试用电流",
      "single_channel_mA": 500
    },

    "calibration_mA": [100, 300, 500, 800],
    "basis_scan_A": 0.5,
    "reference_A": 0.0
  },

  "shim": {
    "mode": "slice_wise_tra",
    "sessions": [1, 2, 3, 4, 5, 6, 7, 8, 10],
    "_sessions_comment": "线圈扫描对应的 session 编号，代码自动格式化为 ses-01 形式",
    "base_session": "ses-01"
  },

  "control": {
    "_comment": "线圈电流下发相关",
    "slice_count": 72,
    "csv_current_unit": "A"
  },

  "hardware": {
    "coil_count": 8,
    "coil_channels": [1, 2, 3, 4, 5, 6, 7, 8]
  },

  "geometry": {
    "cylinder_radius_mm": 145.0,
    "coil_turns": 1,
    "coil_div": 100,
    "coil_shape": "loop"
  },

  "coil_layout": {
    "z_mm": [-60, -40, -20, 0, 20, 40, 60, 80],
    "theta_deg": [0, 45, 90, 135, 180, 225, 270, 315],
    "r_mm": [145, 145, 145, 145, 145, 145, 145, 145]
  },

  "stage1_calibration": {
    "enabled": true,
    "_test_currents_note": "电流值见 current.calibration_mA",
    "settle_time_s": 0.2,
    "repeat": 3,
    "output_file": "./project_data/calibration/calibration_result.json"
  },

  "stage2_basis_scan": {
    "enabled": true,
    "scan_protocol_name": "SE_EPI_B0_basis",
    "_currents_note": "扫描电流见 current.basis_scan_A，参考电流见 current.reference_A",
    "scan_order": [1, 2, 3, 4, 5, 6, 7, 8],
    "output_dir": "./project_data/basis_scan"
  },

  "stage3_shim_fit": {
    "enabled": true,
    "_mode_note": "拟合模式见 shim.mode",
    "slice_order": "ascending",
    "regularization_lambda": 0.0,
    "mask": {
      "mag_thr_ratio": 0.12,
      "erode_radius": 1,
      "b0_mad_factor": 5,
      "min_cluster": 20,
      "min_valid_per_slice": 150
    },
    "input": {
      "b0_map_file": "./project_data/shim_input/b0map_train.mat",
      "basis_file": "./project_data/basis_scan/basis_fields.mat"
    },
    "output": {
      "shim_coeff_csv": "./project_data/shim_result/dynamic_shim_slice_currents.csv",
      "shim_coeff_mat": "./project_data/shim_result/dynamic_shim_result.mat"
    }
  },

  "stage4_online_control": {
    "enabled": true,
    "trigger_mode": "manual_enter",
    "send_zero_before_each_slice": true,
    "send_zero_on_exit": true,
    "min_valid_voxels": 150,
    "slice_table_csv": "./project_data/shim_result/dynamic_shim_slice_currents.csv"
  }
}