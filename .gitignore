# ============================================================
#  EPI_SHIM  .gitignore
#  原则：只公开代码 / 序列 / 设计文件，不公开受试者影像数据
# ============================================================

# ---------- 受试者数据（保密，绝不提交）----------
# 两个数据目录合计约 1 GB，包含 .nii.gz 影像、B0 图、shimming_currents.csv
# 以及 DICOM/JSON sidecar（InstitutionName / DeviceSerialNumber / StationName）
data/
data_/
*.nii
*.nii.gz
*.dcm
*.mat
*.h5
*.mgz

# 若日后需要提交少量“脱敏示例”，请显式取消注释并对单个文件放行，例如：
# !data/example/sanitized_sample.json
# !data/example/README.md

# ---------- 凭据 / 机器相关配置 ----------
.vscode/sftp.json
*.pem
*.key
.env
.env.*
secrets*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# ---------- 运行产物 / 临时文件 ----------
logs/
*.log
octave-workspace